[Unit]
Description=NVIDIA GPU manual fan curve (Docker / FanCurve)
Documentation=https://github.com/RoversX/nvidia_fan_control_linux
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@@PROJECT_DIR@@
# Build (if needed) and start the long-running container; compose handles the daemon.
ExecStart=/usr/bin/docker compose up -d --build
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
